{
  "AzureReadonlyAgent": {
    "TenantId": "<tenant-id>",
    "ClientId": "<service-principal-client-id>",
    "ClientSecret": "USE_ENV_VAR_OR_KEYVAULT"
  },
  "AzureDevOpsAgent": {
    "OrganizationUrl": "https://dev.azure.com/<org>",
    "PersonalAccessToken": "USE_ENV_VAR"
  },
  "GitCloneAgent": {
    "PersonalAccessToken": "USE_ENV_VAR",
    "CloneBasePath": "./repos/"
  },
  "FileReadonlyAgent": {
    "AllowedBasePath": "./data/"
  },
  "FileWriteAgent": {
    "AllowedOutputPath": "./output/"
  }
}
